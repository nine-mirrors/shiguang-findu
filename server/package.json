{
  "name": "findu-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FindU 校园失物招领后端（Node + Express + Prisma + SQLite）",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-generate && node prisma/seed.js",
    "db:seed": "node prisma/seed.js",
    "test:api": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "prisma": "^6.16.0"
  }
}
