# ===== 服务 =====
PORT=4000
NODE_ENV=development

# 运行环境：development 时注册接口会把验证码返回在 devCode 字段，方便联调
# 前端联调时允许的跨域来源，多个用英文逗号分隔；* 表示全部放行
# 例：CORS_ORIGINS=http://localhost:5173,http://localhost:5188
CORS_ORIGINS=*

# ===== 数据库 =====
# SQLite（默认，零配置）
DATABASE_URL="file:./dev.db"

# 切换 MySQL 时：
# 1) 把 prisma/schema.prisma 的 datasource provider 改成 "mysql"
# 2) 注释上面的 SQLite 配置，启用下面这行
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/findu"

# ===== 鉴权 =====
JWT_SECRET=findu-dev-secret-change-me
JWT_EXPIRES_IN=7d

# ===== 上传 =====
# 相对路径基于工程根目录
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ===== 邮箱验证码（演示环境固定验证码）=====
EMAIL_CODE_DEV=123456
